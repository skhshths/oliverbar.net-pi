# Copy to .env and edit. The systemd unit loads this.
PORT=8081
DB_PATH=/home/oliverbarnet/pi-api/chat.db
ALLOW_ORIGIN=*
# The admin key — must match EDIT_PASSWORD on the Cloudflare Worker so the
# admin panel's key works against both backends.
EDIT_PASSWORD=asdfasdfasdf

# where uploaded files are stored on disk (their own folder)
UPLOADS_DIR=/home/oliverbarnet/misc/pi-api/uploads
